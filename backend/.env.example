# Application Configuration
PROJECT_NAME="Visitor Photo Slideshow API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# Database Configuration
# Local SQLite default (ready out-of-the-box):
DATABASE_URL="sqlite:///./slideshow.db"
# PostgreSQL production example:
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/slideshow_db"

# Security Configuration
SECRET_KEY="generate-a-strong-random-secret-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Initial Administrator (Seeded on initial migration / startup)
ADMIN_DEFAULT_USERNAME="admin"
ADMIN_DEFAULT_PASSWORD="ChangeMeInProduction123!"

# Host & Server Configuration
# Set HOST="0.0.0.0" to allow other devices on your local Wi-Fi (like smartphones) to connect
HOST="0.0.0.0"
PORT=8000

# Public Visitor Portal URL (for Smart TV QR Code generation)
# For local-only testing on laptop:
# PUBLIC_PORTAL_URL="http://127.0.0.1:3000"
# For local Wi-Fi / multi-device smartphone testing (replace <YOUR_LAN_IP> with your laptop's Wi-Fi IPv4 address, e.g. 192.168.1.50):
PUBLIC_PORTAL_URL="http://<YOUR_LAN_IP>:3000/"
# For production: Must be a valid public HTTPS URL (localhost strictly forbidden in production):
# PUBLIC_PORTAL_URL="https://photos.yourdomain.com"

# Storage Configuration
UPLOAD_DIR="./uploads"
THUMBNAIL_DIR="./uploads/thumbnails"
MAX_FILE_SIZE_MB=15

# CORS Configuration (comma-separated origins or *)
CORS_ORIGINS="*"
