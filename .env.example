# ==============================================================================
# VISITOR PHOTO SLIDESHOW — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before starting the production deployment:
# cp .env.example .env

# --- Project Identity ---
PROJECT_NAME="Visitor Photo Slideshow API"
VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG="false"

# --- Database Credentials (PostgreSQL) ---
POSTGRES_USER="slideshow_user"
POSTGRES_PASSWORD="replace_with_a_cryptographically_secure_database_password"
POSTGRES_DB="slideshow_db"

# --- Security & Cryptography ---
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
# In production, must be at least 32 characters and cannot use default placeholders
SECRET_KEY="replace_with_a_secure_random_64_character_hex_string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Initial Administrator Bootstrapping ---
# Must be set to a strong password and changed immediately after initial bootstrap
ADMIN_DEFAULT_USERNAME="admin"
ADMIN_DEFAULT_PASSWORD="replace_with_a_strong_bootstrap_password_123!"

# --- Smart TV QR Code Destination URL ---
# The publicly accessible HTTPS URL where visitors reach the upload portal from smartphones
# Localhost is strictly disallowed in production
PUBLIC_PORTAL_URL="https://photos.yourdomain.com"

# --- Upload Limits & Boundaries ---
UPLOAD_DIR="./uploads"
THUMBNAIL_DIR="./uploads/thumbnails"
MAX_FILE_SIZE_MB=15
MAX_UPLOAD_BATCH_SIZE=10

# --- CORS Allowed Origins ---
# In production, specify exact allowed HTTPS domains (wildcard '*' is forbidden):
CORS_ORIGINS="https://photos.yourdomain.com"
